cr),ur={name:`arrow-up-right`,size:24,node:[[`path`,{d:`M7 7h10v10`,key:`1tivn9`}],[`path`,{d:`M7 17 17 7`,key:`1vkiza`}]]};ur.node;var dr=ar(ur),fr={name:`arrow-up`,size:24,node:[[`path`,{d:`m5 12 7-7 7 7`,key:`hav0vg`}],[`path`,{d:`M12 19V5`,key:`x0mq9r`}]]};fr.node;var pr=ar(fr),mr={name:`chevron-down`,size:24,node:[[`path`,{d:`m6 9 6 6 6-6`,key:`qrunsl`}]]};mr.node;var hr=ar(mr),gr={name:`chevron-left`,size:24,node:[[`path`,{d:`m15 18-6-6 6-6`,key:`1wnfg3`}]]};gr.node;var _r=ar(gr),vr={name:`chevron-right`,size:24,node:[[`path`,{d:`m9 18 6-6-6-6`,key:`mthhwq`}]]};vr.node;var yr=ar(vr),br={name:`image`,size:24,node:[[`rect`,{width:`18`,height:`18`,x:`3`,y:`3`,rx:`2`,ry:`2`,key:`1m3agn`}],[`circle`,{cx:`9`,cy:`9`,r:`2`,key:`af1f0g`}],[`path`,{d:`m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21`,key:`1xmnt7`}]]};br.node;var xr=ar(br),Sr={name:`maximize-2`,size:24,node:[[`path`,{d:`M15 3h6v6`,key:`1q9fwt`}],[`path`,{d:`m21 3-7 7`,key:`1l2asr`}],[`path`,{d:`m3 21 7-7`,key:`tjx5ai`}],[`path`,{d:`M9 21H3v-6`,key:`wtvkvv`}]]};Sr.node;var Cr=ar(Sr),wr={name:`menu`,size:24,node:[[`path`,{d:`M4 5h16`,key:`1tepv9`}],[`path`,{d:`M4 12h16`,key:`1lakjw`}],[`path`,{d:`M4 19h16`,key:`1djgab`}]]};wr.node;var Tr=ar(wr),Er={name:`play`,size:24,node:[[`path`,{d:`M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z`,key:`10ikf1`}]]};Er.node;var Dr=ar(Er),Or={name:`triangle-exclamation-point`,size:24,node:[[`path`,{d:`m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3`,key:`wmoenq`}],[`path`,{d:`M12 9v4`,key:`juzpu7`}],[`path`,{d:`M12 17h.01`,key:`p32p05`}]],aliases:[`alert-triangle`,`triangle-alert`]};Or.node;var kr=ar(Or),Ar={name:`x`,size:24,node:[[`path`,{d:`M18 6 6 18`,key:`1bl5f8`}],[`path`,{d:`m6 6 12 12`,key:`d8bk6v`}]]};Ar.node;var jr=ar(Ar),M={title:`Historia Analítica de Colombia`,kicker:`Portafolio digital`,course:`Historia Analítica de Colombia`,university:`Universidad de Ibagué`,description:`Portafolio digital que reúne la investigación, la entrevista y el video reflexivo del trabajo de la asignatura.`,hero:{lead:`Una`,title:`Colombia`,highlight:`con memoria`,tagline:`Memoria, crisis y resistencia.`,image:{src:`/images/collage/plaza.webp`,alt:`Multitud en una plaza frente a una catedral; una persona ondea la bandera de Colombia`},imageIsProvisional:!0},intro:{statement:`Cinco capítulos de la historia reciente del país, reunidos en un solo lugar.`,body:`Este portafolio organiza los materiales del trabajo: una investigación dividida en cinco capítulos, una entrevista y un video reflexivo. Cada sección puede recorrerse de forma independiente.`,images:[{src:`/images/backgrounds/intro-horizontal.jpg`,alt:`Multitud congregada durante una manifestación, con carpas y paraguas en la calle.`,caption:`Manifestaciones sociales del 20 de julio de 2021.`,credit:`Resilientes89 / Wikimedia Commons · CC BY-SA 4.0`},{src:`/images/backgrounds/intro-vertical.jpg`,alt:`Pancarta amarilla, azul y roja sobre la calle durante una protesta, con dos manifestantes debajo.`,caption:`Manifestaciones sociales del 20 de julio de 2021.`,credit:`Resilientes89 / Wikimedia Commons · CC BY-SA 4.0`}]}},Mr=[{label:`Inicio`,to:`/`},{label:`Investigación`,to:`/investigacion`,index:`01`,description:`Contextos y análisis`,image:{src:`/images/collage/tarjeta-investigacion.webp`,alt:`Vista de una ciudad`}},{label:`Entrevista`,to:`/entrevista`,index:`02`,description:`Voces que cuentan`,image:{src:`/images/collage/tarjeta-entrevista.webp`,alt:`Micrófono`}},{label:`Video reflexivo`,to:`/video-reflexivo`,index:`03`,description:`Miradas sobre el país`,image:{src:`/images/collage/tarjeta-video.webp`,alt:`Persona con una cámara de video`}},{label:`Integrantes`,to:`/integrantes`,index:`04`,description:`El equipo`,image:{src:`/images/collage/tarjeta-integrantes.webp`,alt:`Grupo de personas abrazadas`}}],Nr=Mr.filter(e=>e.index);function Pr(e){let t=Mr.find(t=>t.to===e);if(!t)throw Error(`No existe una sección con la ruta "${e}"`);return t}var Fr=`${M.kicker} · ${M.university}`,Ir=`/images/collage/fotograma-plaza.webp`,Lr=[{id:`capitulo-1`,number:1,slug:`seguridad-democratica`,title:`Seguridad Democrática`,period:`2002 – 2010`,summary:`Los dos gobiernos de Álvaro Uribe recuperaron territorio y redujeron homicidios y secuestros, pero dejaron la mayor herida de derechos humanos del conflicto reciente: los “falsos positivos”.`,cover:{src:`/images/historical/cap-01-portada.webp`,alt:`Álvaro Uribe Vélez responde a los periodistas rodeado de micrófonos y grabadoras.`,caption:`Álvaro Uribe Vélez, presidente de Colombia entre 2002 y 2010, atiende a la prensa en Brasilia en mayo de 2008.`,credit:`José Cruz / Agência Brasil · CC BY 3.0 BR`},introduction:`En 2002 Colombia eligió presidente en medio del miedo. Los diálogos del Caguán acababan de romperse, las FARC secuestraban en las carreteras y cientos de alcaldes gobernaban lejos de sus municipios. Álvaro Uribe Vélez ganó en primera vuelta con una promesa sencilla: que el Estado volviera a mandar en todo el territorio.

La Política de Defensa y Seguridad Democrática cumplió buena parte de esa promesa y por eso fue muy popular. También mostró qué ocurre cuando el éxito de la fuerza pública se mide en bajas. Este capítulo recorre las dos caras del periodo y lo que de él sigue vivo hoy.`,content:[{type:`heading`,text:`1. Por qué el país respaldó la mano firme`},{type:`paragraph`,text:`**Seguridad.** El fracaso del Caguán (1998–2002) convenció a muchos colombianos de que negociar no funcionaba. En 2002 la tasa de homicidios era de 69,8 por cada 100.000 habitantes, según cifras de la Policía Nacional divulgadas por el Ministerio de Defensa. Los secuestros en retenes ilegales, las “pescas milagrosas”, habían vuelto peligroso viajar entre ciudades.`},{type:`paragraph`,text:`**Economía.** La violencia frenaba la inversión, el transporte de carga y el turismo. El gobierno unió seguridad y “confianza inversionista” en un mismo discurso, y los gremios aceptaron pagar un impuesto al patrimonio para financiar a la fuerza pública.`},{type:`paragraph`,text:`**Sociedad.** Tras décadas de guerra había un cansancio profundo. La promesa de orden conectó con las clases medias urbanas, con familias de secuestrados y con habitantes rurales expuestos a la extorsión.`},{type:`paragraph`,text:`**Quiénes la apoyaron.** Gremios empresariales y ganaderos, clases medias de las ciudades, sectores conservadores y religiosos, y gran parte de los partidos tradicionales. Uribe fue reelegido en 2006, también en primera vuelta.`},{type:`paragraph`,text:`**Quiénes la rechazaron.** Organizaciones de derechos humanos y de víctimas de agentes del Estado, sindicatos, la izquierda política y comunidades indígenas y campesinas que denunciaron detenciones masivas y estigmatización. También hubo críticas de organismos internacionales y choques con la Corte Suprema por la “parapolítica” y las interceptaciones ilegales del DAS.`},{type:`heading`,text:`2. Lo que el Estado mostró como logro`},{type:`paragraph`,text:`El objetivo oficial era, en palabras del Ministerio de Defensa (2007), la recuperación del control del Estado sobre la mayor parte del territorio. Los resultados reportados fueron estos:`},{type:`table`,table:{headers:[`Indicador`,`2002`,`2010`,`Fuente`],rows:[[`Homicidios (casos)`,`28.837`,`15.459`,`Centro Democrático, con datos de MinDefensa`],[`Tasa de homicidios por 100.000 hab.`,`69,8`,`34`,`Ministerio de Defensa, 2011`],[`Secuestro (variación en ocho años)`,`—`,`−91 %`,`Revista de la Escuela Superior de Guerra`]]}},{type:`paragraph`,text:`Solo en el primer cuatrienio, los secuestros extorsivos cayeron 83 % y los atentados terroristas 61 %, según el mismo documento del Ministerio. La Policía volvió a todas las cabeceras municipales y las FARC perdieron movilidad, corredores y mandos: en 2008 murió Raúl Reyes y la Operación Jaque liberó a quince secuestrados. Entre 2003 y 2006 se desmovilizaron además las AUC bajo la Ley de Justicia y Paz.`},{type:`paragraph`,text:`Estas cifras son oficiales y tienen críticos. Un balance académico de la Universidad Nacional advierte que medir el éxito por bajas, capturas y desmovilizados decía poco sobre la protección real de la población.`},{type:`heading`,text:`3. La otra cara: derechos humanos y “falsos positivos”`},{type:`paragraph`,text:`Se llama “falsos positivos” a los asesinatos de civiles, en su mayoría jóvenes pobres, que integrantes del Ejército presentaron como guerrilleros dados de baja. El caso de los jóvenes de Soacha, en 2008, lo hizo público.`},{type:`paragraph`,text:`La Jurisdicción Especial para la Paz estableció en el Auto 033 de 2021 que al menos 6.402 personas fueron víctimas entre 2002 y 2008, el 78 % de todos los casos históricos, y que Antioquia concentró una cuarta parte, según el comunicado 019 de la JEP. La cifra casi triplica las 2.248 víctimas que había reportado la Fiscalía.`},{type:`quote`,text:`“…muertas ilegítimamente para ser presentadas como bajas en combate”.`,attribution:`Jurisdicción Especial para la Paz, Comunicado 019 de 2021`},{type:`paragraph`,text:`El debate tiene tres frentes:`},{type:`list`,items:[`**Las causas.** Víctimas y organizaciones de derechos humanos sostienen que la presión por resultados y las recompensas, como la Directiva 029 de 2005, incentivaron el crimen. El expresidente Uribe ha rechazado esa lectura y cuestionó los datos de la JEP.`,`**La cifra.** La JEP la presenta como un universo provisional, según explicó La Silla Vacía; las madres de Soacha creen que es mayor.`,`**La justicia.** El 18 de septiembre de 2025 la JEP dictó su primera sentencia del caso: doce exmilitares del Batallón La Popa recibieron sanciones de hasta ocho años por 135 asesinatos y desapariciones en el Caribe, como reportó Radio Nacional.`]},{type:`heading`,text:`4. Qué se mantiene y qué cambió`},{type:`table`,table:{headers:[`Se mantiene`,`Se modificó`],rowHeaders:!1,rows:[[`La presencia militar como primera respuesta del Estado en zonas de conflicto.`,`Los crímenes de la fuerza pública en el conflicto pasaron a la justicia transicional (JEP), creada por el Acuerdo de 2016.`],[`La Policía sigue adscrita al Ministerio de Defensa; la CIDH recomendó separarla en 2021.`,`El éxito ya no se mide oficialmente por bajas; las directivas de recompensas fueron retiradas.`],[`La lucha contra el narcotráfico y la erradicación como ejes de seguridad.`,`Entre 2012 y 2026 el Estado alternó fuerza y negociación: La Habana y luego la “paz total”.`],[`El discurso de autoridad: el gobierno que empezó en agosto de 2026 llama a su plan “Seguridad Democrática 2.0”, según RCN Radio.`,`Hoy existen el enfoque territorial (PDET), el Sistema de Verdad y la vigilancia internacional de la protesta y del uso de la fuerza.`]]}}],gallery:[{src:`/images/historical/cap-01-galeria-01.webp`,alt:`Cuatro mujeres de pie, una junto a otra, en un parque.`,caption:`Las madres de Soacha convirtieron su duelo en la denuncia de los “falsos positivos”. Fotografía de 2013.`,credit:`Contrast Periodistes · CC BY 3.0`},{src:`/images/historical/cap-01-galeria-02.webp`,alt:`Camiseta gris extendida, intervenida con hilo dorado y lentejuelas.`,caption:`Camiseta que llevaba Julián Oviedo Monroy cuando encontraron su cuerpo, intervenida por su madre, Blanca Monroy.`,credit:`Blanca Monroy, 2025 · CC BY 4.0`},{src:`/images/historical/cap-01-galeria-03.webp`,alt:`Mujeres bordan una tela verde sobre una mesa, bajo una carpa.`,caption:`Integrantes de MAFAPO en la Plaza de Bolívar de Bogotá, 2016.`,credit:`AmiGueko · CC0`},{src:`/images/historical/cap-01-galeria-04.webp`,alt:`Lienzo pintado en blanco y negro con una mujer embarazada, jóvenes de pie sobre cráneos, militares y botas, colgado frente a una pared de nichos.`,caption:`Mural móvil “¿Quién dio la orden?” de MAFAPO, expuesto en el Cementerio Central de Bogotá, 2026.`,credit:`MAFAPO · CC BY-SA 4.0`},{src:`/images/historical/cap-01-galeria-05.webp`,alt:`Gráfico de líneas con los casos por año entre 2002 y 2008 en Costa Caribe, Antioquia, Huila, Meta y Casanare; el máximo se alcanza en 2007.`,caption:`Evolución de los casos de “falsos positivos” por región, 2002–2008, según el macrocaso 03.`,credit:`Jurisdicción Especial para la Paz · CC BY-SA 4.0`}],artwork:{title:`¿Quién dio la orden?`,artist:`Campaña por la Verdad (MOVICE y organizaciones de víctimas y derechos humanos)`,year:`2019`,technique:`Mural colectivo, pintura sobre muro; reproducido después en afiches y pancartas`,image:{src:`/images/artworks/cap-01-obra.webp`,alt:`Fachada de un edificio universitario con murales; uno, de fondo amarillo, muestra rostros de militares, la pregunta “¿Quién dio la orden?” y la cifra 5763.`,caption:`Réplica del mural en la Universidad de Antioquia, Medellín, 2025.`,credit:`Laollietopia · CC0`},commentary:`El mural muestra los rostros de altos mandos militares junto al número de ejecuciones extrajudiciales y una sola pregunta. Fue borrado por uniformados la misma noche en que se pintó, en Bogotá, y eso lo multiplicó en camisetas, redes y calles. En 2021 la Corte Constitucional (sentencia T-281) protegió la imagen como ejercicio de libertad de expresión y memoria. Resume la discusión central del capítulo: hasta dónde llega la responsabilidad cuando el Estado premia resultados medidos en muertos. Cuando la JEP publicó su cifra, las réplicas del mural se actualizaron a 6.402.`},references:[{id:`ref-01`,citation:`Atehortúa Cruz, A. L., & Rojas Rivera, D. M. (2009). La política de consolidación de la seguridad democrática: balance 2006-2008. Análisis Político, (66), 59-80.`,url:`https://revistas.unal.edu.co/index.php/anpol/article/download/45910/47473/222618`},{id:`ref-02`,citation:`El Colombiano. (2021, 18 de febrero). JEP dice que entre 2002 y 2008 se cometieron 6.402 falsos positivos en Colombia.`,url:`https://www.elcolombiano.com/colombia/jep-dice-que-entre-2002-y-2008-se-cometieron-6402-falsos-positivos-en-colombia-AF14666666`},{id:`ref-03`,citation:`Jurisdicción Especial para la Paz. (2021). Comunicado 019 de 2021: La JEP hace pública la estrategia de priorización dentro del Caso 03.`,url:`https://www.lavozdelderecho.com/files/COMUNICADO_019_DE_2021.pdf`},{id:`ref-04`,citation:`La Silla Vacía. (2021). Así llegó la JEP a la cifra de 6.402 víctimas de falsos positivos.`,url:`https://www.lasillavacia.com/historias/silla-nacional/asi-llego-la-jep-a-la-cifra-de-6402-victimas-de-falsos-positivos`},{id:`ref-05`,citation:`Ministerio de Defensa Nacional. (2007). Política de Consolidación de la Seguridad Democrática (PCSD). Imprenta Nacional de Colombia.`,url:`https://www.resdal.org/ultimos-documentos/col-pcsd.pdf`},{id:`ref-06`,citation:`Ministerio de Defensa Nacional. (2011, 21 de enero). 2010 registró la cifra más baja de homicidios de los últimos 24 años [Comunicado].`,url:`https://www.ambitojuridico.com/sites/default/files/BancoMedios/Archivos/comunicado%202010%2C%20el%20a%C3%B1o%20de%20menos%20homicidios%20-%2011.doc`},{id:`ref-07`,citation:`Radio Nacional de Colombia. (2025, 18 de septiembre). JEP emitió sentencia a 12 militares del Batallón La Popa por falsos positivos.`,url:`https://radionacional.co/actualidad/judicial/jep-emitio-sentencia-12-militares-del-batallon-la-popa-por-falsos-positivos`},{id:`ref-08`,citation:`RCN Radio. (2026). ¿Qué propone el presidente Abelardo de la Espriella en materia de seguridad para su gobierno 2026–2030?`,url:`https://newsroom.rcnradio.com/colombia/cual-es-la-propuesta-de-seguridad-de-abelardo-de-la-espriella-para-su-presidencia-2026-2030`},{id:`ref-09`,citation:`Centro Democrático. (2019). Seguridad Democrática [Documento de partido con cifras del Ministerio de Defensa].`,url:`https://centrodemocratico.com/wp-content/uploads/2019/05/Seguridad-Democr%E2%80%A0tica.pdf`},{id:`ref-10`,citation:`Escuela Superior de Guerra. (s. f.). El secuestro en el marco de la Política de Seguridad Democrática. Revista Fuerzas Armadas.`,url:`https://esdegrevistas.edu.co/index.php/refa/article/download/945/1206/3162`}]},{id:`capitulo-2`,number:2,slug:`acuerdos-de-la-habana`,title:`Acuerdos de La Habana`,period:`2012 – 2016 (con efectos hasta hoy)`,summary:`Cuatro años de negociación desarmaron a la guerrilla más antigua del continente, pero el país se partió en dos al decidir si aprobaba lo pactado.`,cover:{src:`/images/historical/cap-02-portada.webp`,alt:`Invitados vestidos de blanco, sentados en una plaza de Cartagena; al fondo, una pantalla gigante muestra la tarima.`,caption:`Cartagena, 26 de septiembre de 2016: invitados de blanco, entre ellos el secretario de Estado de EE. UU., John Kerry, antes de la firma del Acuerdo.`,credit:`U.S. Department of State · Dominio público`},introduction:`Entre 2012 y 2016 el gobierno de Juan Manuel Santos y las FARC-EP negociaron en La Habana el final de un conflicto de más de cincuenta años. El resultado fue un acuerdo de seis puntos que iba mucho más allá de entregar las armas: hablaba de tierra, de política, de drogas, de víctimas.

Lo más difícil no fue firmarlo sino refrendarlo. El 2 de octubre de 2016 el No ganó el plebiscito por menos de un punto. Este capítulo explica qué se pactó, por qué dividió al país y qué pasó en los territorios cuando las FARC se fueron.`,content:[{type:`heading`,text:`1. Tierra y votos: los dos puntos que más discusión provocaron`},{type:`paragraph`,text:`El Acuerdo tiene seis puntos: reforma rural integral, participación política, fin del conflicto, drogas ilícitas, víctimas, e implementación y verificación.`},{type:`paragraph`,text:`**Punto 1, Reforma Rural Integral.** Partía de que la desigualdad en el campo alimentó la guerra. Sus compromisos principales:`},{type:`list`,items:[`Un Fondo de Tierras de 3 millones de hectáreas para campesinos sin tierra o con tierra insuficiente.`,`La formalización de 7 millones de hectáreas de pequeña y mediana propiedad.`,`Un catastro rural actualizado y Programas de Desarrollo con Enfoque Territorial (PDET) en las zonas más golpeadas.`]},{type:`paragraph`,text:`Las metas de tierra están en la cartilla oficial de la Cancillería y en el Decreto Ley 902 de 2017.`},{type:`paragraph`,text:`**Punto 2, Participación política.** Las FARC dejaban las armas y se convertían en partido legal (hoy Comunes), con diez curules garantizadas en el Congreso durante dos periodos. Se pactó además un estatuto de la oposición y 16 curules transitorias en la Cámara para las regiones más afectadas. Tras la renegociación quedó claro que esas 16 curules eran para comunidades y víctimas, no para las FARC, como recogió El Heraldo.`},{type:`paragraph`,text:`**Cómo reaccionó el país**`},{type:`table`,table:{headers:[`Sector`,`Reacción`],rows:[[`Organizaciones campesinas, étnicas y de víctimas`,`Apoyo: veían por primera vez una agenda para el campo.`],[`Gremios ganaderos y parte del empresariado rural`,`Temor por la propiedad privada, aunque analistas señalaron que el Fondo equivalía a cerca del 3 % del área catastral rural.`],[`Centro Democrático y sectores conservadores`,`Rechazo a que responsables de crímenes graves llegaran al Congreso sin pagar cárcel.`],[`Iglesias y grupos religiosos`,`Divididos; una parte rechazó el enfoque de género del texto.`],[`Comunidad internacional`,`Respaldo amplio; Santos recibió el Nobel de Paz en octubre de 2016.`]]}},{type:`heading`,text:`2. El plebiscito del 2 de octubre de 2016`},{type:`table`,table:{headers:[``,`Argumentos del Sí`,`Argumentos del No`],rows:[[`Políticos`,`Era la mejor salida posible tras décadas de guerra sin vencedor. Cambiar balas por votos fortalece la democracia.`,`Las FARC no debían recibir curules ni elegibilidad sin cumplir antes penas. El acuerdo podía renegociarse.`],[`Sociales`,`Menos víctimas, más inversión en el campo, regreso de desplazados.`,`Los beneficios económicos a excombatientes eran injustos frente a ciudadanos que nunca delinquieron.`],[`Éticos`,`La verdad y la reparación valen más para las víctimas que la cárcel. Perdonar es condición para convivir.`,`Sin castigo proporcional hay impunidad. Sectores religiosos objetaron además lo que llamaron “ideología de género”.`]]}},{type:`quote`,text:`“Si el plebiscito no se aprueba volvemos a la guerra, así de sencillo”.`,attribution:`Juan Manuel Santos, 16 de junio de 2016, citado por Noticias RCN`},{type:`paragraph`,text:`**El resultado.** El No obtuvo 6.431.376 votos (50,21 %) y el Sí 6.377.482 (49,78 %). Votó solo el 37,4 % del censo, según los datos de la Registraduría recogidos por El Heraldo. La diferencia fue de unos 54.000 votos. El Sí ganó en buena parte de las regiones periféricas más afectadas por la guerra; el No, en casi toda la zona andina, salvo Bogotá y Boyacá.`},{type:`paragraph`,text:`**Las consecuencias.**`},{type:`list`,items:[`**Renegociación.** En 41 días se ajustó el texto: el plazo de la reforma rural pasó de 10 a 15 años y se precisó el respeto a la propiedad privada, según las notas oficiales sobre los cambios.`,`**Refrendación por el Congreso.** El nuevo acuerdo se firmó el 24 de noviembre de 2016 en el Teatro Colón y lo aprobó el Congreso, no las urnas. Sus críticos nunca aceptaron esa vía.`,`**Implementación lenta.** A casi diez años, el Instituto Kroc calcula que poco más del 35 % de las 578 disposiciones está completo, según Cambio. En tierras se ha entregado cerca del 11 % de la meta y formalizado el 56 %, de acuerdo con CIDOB.`]},{type:`heading`,text:`3. La seguridad después de las FARC: dos países`},{type:`paragraph`,text:`Cerca de 13.000 integrantes de las FARC dejaron las armas en 2017 bajo verificación de la ONU. Los combates entre esa guerrilla y el Estado prácticamente desaparecieron.`},{type:`paragraph`,text:`**Donde la convivencia avanzó.** En zonas como el sur del Tolima, los Montes de María o partes de Caquetá y Meta, la salida de las FARC permitió reabrir caminos, escuelas y proyectos productivos, algunos manejados por excombatientes y vecinos. La mayoría de firmantes sigue en la legalidad.`},{type:`paragraph`,text:`**Donde llegaron nuevas disputas.** En el Catatumbo, Cauca, el Pacífico nariñense, el Bajo Cauca, Chocó y Guaviare, el Estado no ocupó a tiempo el espacio que dejaron las FARC. Disidencias, el ELN y el Clan del Golfo se disputan allí la coca, la minería ilegal y las rutas. Los líderes sociales y los propios firmantes pagan el costo: entre la firma y diciembre de 2025 fueron asesinados 487 excombatientes, aproximadamente uno por semana, según el Council on Foreign Relations. La Fiscalía cuenta 521 hasta noviembre de 2026, de acuerdo con El Espectador.`},{type:`paragraph`,text:`La conclusión es que el Acuerdo terminó una guerra, no todas las violencias.`}],gallery:[{src:`/images/historical/cap-02-galeria-01.webp`,alt:`Dos delegaciones conversan sentadas en sofás alrededor de una mesa baja.`,caption:`La Habana, 21 de marzo de 2016: jefes de las FARC se reúnen con el secretario de Estado de EE. UU., John Kerry, durante las negociaciones.`,credit:`U.S. Department of State · Dominio público`},{src:`/images/historical/cap-02-galeria-02.webp`,alt:`Juan Manuel Santos, Nicolás Maduro y John Kerry, vestidos de blanco, conversan de pie mientras varios fotógrafos los retratan.`,caption:`Juan Manuel Santos con John Kerry y Nicolás Maduro en Cartagena, el día de la firma, 26 de septiembre de 2016.`,credit:`U.S. Department of State · Dominio público`},{src:`/images/historical/cap-02-galeria-03.webp`,alt:`Una pantalla gigante muestra una firma sobre el documento del acuerdo; abajo, el público toma fotografías.`,caption:`La firma de Timoleón Jiménez, jefe de las FARC, proyectada durante la ceremonia de Cartagena.`,credit:`U.S. Department of State · Dominio público`},{src:`/images/historical/cap-02-galeria-04.webp`,alt:`Mapa de Colombia por departamentos, en dos colores según ganó el Sí o el No.`,caption:`Plebiscito del 2 de octubre de 2016 por departamento: en verde donde ganó el Sí, en rojo donde ganó el No.`,credit:`Milenioscuro · CC BY-SA 4.0`},{src:`/images/historical/cap-02-galeria-05.webp`,alt:`Marcha nocturna: varias mujeres sostienen una pancarta de tela con las palabras “Costurero de la Memoria”.`,caption:`Bogotá, 5 de octubre de 2016: marcha por la paz tres días después del plebiscito.`,credit:`MAFAPO · CC BY-SA 4.0`},{src:`/images/historical/cap-02-galeria-06.webp`,alt:`Dos personas llevan por una avenida una colcha bordada y retratos de dos jóvenes.`,caption:`Marcha en apoyo al acuerdo de paz, 5 de octubre de 2016.`,credit:`MAFAPO · CC BY-SA 4.0`}],artwork:{title:`Fragmentos, espacio de arte y memoria`,artist:`Doris Salcedo`,year:`2018`,technique:`Contramonumento: piso de baldosas hechas con el metal fundido de las armas entregadas por las FARC`,image:{src:`/images/artworks/cap-02-obra.webp`,alt:`Corredor acristalado con piso de baldosas metálicas de relieve irregular; afuera, los muros en ruinas de una casa antigua.`,caption:`Interior de Fragmentos, Bogotá, 2024.`,credit:`Anfecaro · CC0`},commentary:`El Acuerdo ordenó hacer tres monumentos con las armas de las FARC. Para el de Bogotá, Salcedo se negó a levantar algo que mirara desde arriba: fundió unas 37 toneladas de armamento y las convirtió en el suelo de una casa en ruinas. Mujeres víctimas de violencia sexual martillaron los moldes de las baldosas. Quien entra pisa las armas. La obra traduce el subtítulo del capítulo: la palabra pactada quedó literalmente por encima de los fusiles. También deja ver la fractura, porque es un lugar de duelo y no de celebración.`},references:[{id:`ref-01`,citation:`Cancillería de Colombia. (2016). Acuerdo de bolsillo.`,url:`https://www.cancilleria.gov.co/sites/default/files/Fotos2016/acuerdo_de_bolsillo.pdf`},{id:`ref-02`,citation:`Cancillería de Colombia. (2016). Notas sobre los cambios, ajustes y precisiones del nuevo Acuerdo Final.`,url:`https://www.cancilleria.gov.co/sites/default/files/notassobreloscambiosajustesyprecisionesdelnuevoacuerdofinal.pdf`},{id:`ref-03`,citation:`Cambio. (2026, abril). Acuerdo de paz: rezagos, avances y retos de implementación para el próximo presidente.`,url:`https://cambiocolombia.com/poder/articulo/2026/4/acuerdo-paz-rezagos-avances-retos-implementacion-proximo-presidente`},{id:`ref-04`,citation:`CIDOB. (s. f.). Implementación del Acuerdo Final de Paz. Barcelona Centre for International Affairs.`,url:`https://www.cidob.org/ca/publicacions/implementacion-del-acuerdo-final-paz`},{id:`ref-05`,citation:`Council on Foreign Relations. (2026). Prevenir un nuevo conflicto en Colombia.`,url:`https://assets.cfr.org/images/Preventing-Renewed-Conflict-in-Colombia_Spanish-/Preventing-Renewed-Conflict-in-Colombia_Spanish-.pdf`},{id:`ref-06`,citation:`El Espectador. (2026, 14 de noviembre). La paz y De la Espriella: la política de mano dura y no negociación que instauró en 100 días.`,url:`https://www.elespectador.com/politica/la-paz-y-de-la-espriella-la-politica-de-mano-dura-y-no-negociacion-que-instauro-en-100-dias/`},{id:`ref-07`,citation:`El Heraldo. (2016, 3 de octubre). Los colombianos dicen “no” al acuerdo de paz con las Farc.`,url:`https://www.elheraldo.co/politica/2016/10/03/los-colombianos-dicen-no-al-acuerdo-de-paz-con-las-farc-289916/`},{id:`ref-08`,citation:`El Heraldo. (2016, 13 de noviembre). Farc y Gobierno llegan a nuevo acuerdo de paz con ajustes.`,url:`https://www.elheraldo.co/colombia/2016/11/13/farc-y-gobierno-llegan-a-nuevo-acuerdo-de-paz-con-ajustes-301681/`},{id:`ref-09`,citation:`El Tiempo. (2016). El acuerdo de reforma rural integral [Opinión].`,url:`https://www.eltiempo.com/archivo/documento/CMS-16722157`},{id:`ref-10`,citation:`El Universal. (2017, 31 de mayo). Abecé del decreto para el acceso y formalización de las tierras.`,url:`https://www.eluniversal.com.co/colombia/bogota/2017/05/31/abece-del-decreto-para-el-acceso-y-formalizacion-de-las-tierras/`},{id:`ref-11`,citation:`Noticias RCN. (s. f.). Así fue el resultado del plebiscito en octubre de 2016.`,url:`https://www.noticiasrcn.com/colombia/asi-fue-el-resultado-del-plebiscito-en-octubre-de-2016-306206`}]},{id:`capitulo-3`,number:3,slug:`covid-19-y-estallido-social`,title:`COVID-19 y estallido social`,period:`2020 – 2021`,summary:`La cuarentena dejó sin ingresos a millones de trabajadores informales y llevó la pobreza al 42,5 %. Un año después, una reforma tributaria encendió la mayor protesta en décadas.`,cover:{src:`/images/historical/cap-03-portada.webp`,alt:`Un hombre con tapabocas y chaqueta roja sostiene un trapo rojo en el alero de una casa.`,caption:`Soacha, abril de 2020: un trapo rojo durante la entrega de ayudas humanitarias del alcalde Juan Carlos Saldarriaga.`,credit:`Diana Milena Buitrago · CC BY-SA 4.0`},introduction:`El 25 de marzo de 2020 Colombia entró en cuarentena obligatoria. Para quien tenía salario fijo y computador, la vida se mudó a una pantalla. Para quien vivía de lo que vendía cada día, quedarse en casa significaba no comer. Los trapos rojos en las ventanas se volvieron la señal de hambre de los barrios.

La pandemia no inventó la desigualdad colombiana, pero la puso a la vista de todos. Cuando en abril de 2021 el gobierno propuso subir impuestos, ese malestar acumulado salió a la calle. Este capítulo sigue el hilo que une el encierro con el estallido: trabajo, educación y salud mental.`,content:[{type:`heading`,text:`1. Lo que la cuarentena reveló del trabajo y la protección social`},{type:`paragraph`,text:`**Un país que vive del día.** Más de la mitad de los ocupados en Colombia trabaja en la informalidad, sin contrato, pensión ni seguro de desempleo. El confinamiento cortó de un día para otro el ingreso de vendedores, empleadas domésticas, transportadores y trabajadores de servicios, como documenta la Universidad del Rosario.`},{type:`paragraph`,text:`**El golpe en cifras.**`},{type:`table`,table:{headers:[`Indicador`,`Antes (2019)`,`2020`,`Fuente`],rows:[[`Pobreza monetaria`,`35,7 %`,`42,5 %`,`DANE`],[`Personas en pobreza`,`17,4 millones`,`21 millones`,`DANE`],[`Pobreza extrema`,`9,6 %`,`15,1 %`,`Forbes Colombia, con datos DANE`],[`Crecimiento del PIB`,`—`,`−6,8 %`,`La República`]]}},{type:`paragraph`,text:`El DNP calculó que en 2020 se perdieron cerca de 2,4 millones de empleos frente a 2019, con mayor impacto en mujeres y jóvenes (DNP, 2021). El desempleo superó el 20 % en mayo de 2020.`},{type:`paragraph`,text:`**Una red de protección con huecos.** La seguridad social colombiana está atada al empleo formal, de modo que la mayoría quedó por fuera. El Estado respondió con transferencias de emergencia como Ingreso Solidario. Sirvieron: sin ellas la pobreza habría llegado al 46,1 %, según el DANE citado por Portafolio. Pero no alcanzaron para evitar que 3,5 millones de personas cayeran en la pobreza.`},{type:`heading`,text:`2. Educación: de la virtualidad forzada a las aulas en paro`},{type:`paragraph`,text:`**La brecha digital.** Estudiar desde casa exigía internet y un equipo. No todos los tenían:`},{type:`table`,table:{headers:[`Hogares, 2020`,`Total nacional`,`Cabeceras`,`Zona rural`],rows:[[`Con conexión a internet`,`56,5 %`,`66,6 %`,`23,9 %`],[`Con computador o tableta`,`39,3 %`,`48,2 %`,`10,4 %`]],note:`Fuentes: Encuesta de Calidad de Vida del DANE, citada por EAFIT, y encuesta TIC del DANE, citada por La Silla Vacía.`}},{type:`paragraph`,text:`**Cómo cambió la enseñanza.** Los colegios improvisaron con guías impresas, radio, televisión y WhatsApp. Muchos docentes aprendieron a enseñar en línea sobre la marcha, y la educación híbrida se quedó después como opción. El costo fue alto: la inasistencia escolar pasó de 4,6 % a 30,1 % en el campo y de 2,4 % a 12,4 % en las ciudades, según el índice de pobreza multidimensional citado por La Silla Vacía. En 2020 reprobó el año el 11,3 % de los estudiantes de secundaria, señala Bancolombia.`},{type:`paragraph`,text:`**El paro como aula.** En 2021 los jóvenes, muchos sin estudio ni trabajo, fueron el centro de la protesta. Universidades públicas entraron en asamblea y surgieron clases a la calle, ollas comunitarias y bibliotecas populares en los puntos de resistencia. Una de las respuestas del gobierno fue la matrícula gratuita para estudiantes de bajos ingresos en universidades públicas, una demanda estudiantil de años.`},{type:`heading`,text:`3. Salud mental: el costo invisible`},{type:`paragraph`,text:`**Durante el aislamiento.** Seis de cada diez personas encuestadas por el DANE dijeron haber tenido síntomas como preocupación, tristeza, cansancio o dificultad para dormir, informó El Tiempo. El 40,4 % de los jefes de hogar reportó preocupación o nerviosismo en julio de 2020, y un año después la cifra seguía en 39 %. Los más afectados fueron los jóvenes de 10 a 24 años y las mujeres, según el informe del DANE reseñado por El Espectador.`},{type:`paragraph`,text:`**Durante el paro.** A la soledad y al duelo se sumaron semanas de bloqueos, enfrentamientos, videos de violencia en redes y miedo en los barrios. Tras su visita de junio de 2021, la CIDH entregó al Estado 41 recomendaciones, según NTN24.`},{type:`quote`,text:`La respuesta del Estado se basó en un “uso desproporcionado de la fuerza”.`,attribution:`Comisión Interamericana de Derechos Humanos, julio de 2021, citada por La Estrella de Panamá`},{type:`paragraph`,text:`**Los debates que quedaron.**`},{type:`list`,items:[`Si la salud mental es un asunto individual o un problema público ligado a la pobreza y el desempleo.`,`La falta de psicólogos y psiquiatras en el sistema de salud, sobre todo fuera de las grandes ciudades.`,`La atención a jóvenes, a víctimas de violencia en la protesta y a policías.`,`El papel del colegio: orientación escolar y habilidades socioemocionales.`]},{type:`paragraph`,text:`La discusión llegó al Congreso, que en 2025 actualizó la ley de salud mental de 2013 (Ley 2460 de 2025).`},{type:`heading`,text:`Cronología mínima del estallido`},{type:`list`,ordered:!0,items:[`**28 de abril de 2021.** Empieza el paro nacional contra la reforma tributaria.`,`**2 de mayo.** El gobierno de Iván Duque retira el proyecto; poco después renuncia el ministro de Hacienda.`,`**Mayo y junio.** Las protestas siguen por empleo, educación, salud y violencia policial. Cali es el epicentro.`,`**8 al 10 de junio.** Visita de trabajo de la CIDH.`]}],gallery:[{src:`/images/historical/cap-03-galeria-01.webp`,alt:`Un grupo de mariachis toca en la calle frente a un edificio de apartamentos; algunos vecinos miran desde los balcones.`,caption:`Bogotá, 13 de junio de 2020: un mariachi toca por propinas durante la pandemia.`,credit:`Carlos Felipe Pardo · CC BY 2.0`},{src:`/images/historical/cap-03-galeria-02.webp`,alt:`Cartel en una estación de transporte: “Atención. Mantén el distanciamiento social”.`,caption:`Medellín, mayo de 2020: señalización de distanciamiento en el Metroplús.`,credit:`XalD · CC BY-SA 4.0`},{src:`/images/historical/cap-03-galeria-03.webp`,alt:`Una trabajadora de la salud con bata, gorro y tapabocas vacuna a una mujer sentada.`,caption:`Julio de 2021: vacunación contra el COVID-19 en un punto móvil.`,credit:`USAID Colombia · Dominio público`},{src:`/images/historical/cap-03-galeria-04.webp`,alt:`Vista desde lo alto de una avenida con manifestantes, camisetas y banderas de Colombia y consignas pintadas en el asfalto.`,caption:`Cali, 1 de mayo de 2021: marcha contra la reforma tributaria.`,credit:`Remux · CC BY-SA 4.0`},{src:`/images/historical/cap-03-galeria-05.webp`,alt:`Multitud de manifestantes con cascos, tapabocas y banderas.`,caption:`Bogotá, 20 de julio de 2021: manifestantes en el Monumento a los Héroes.`,credit:`Resilientes89 · CC BY-SA 4.0`},{src:`/images/historical/cap-03-galeria-06.webp`,alt:`Jardín con escudos pintados, cascos y retratos apoyados en el suelo.`,caption:`Puerto Resistencia, Cali, junio de 2021: escudos y cascos en un jardín de memoria.`,credit:`Remux · CC BY-SA 4.0`}],artwork:{title:`Monumento a la Resistencia`,artist:`Obra colectiva de manifestantes, artistas y vecinos de Puerto Resistencia, Cali`,year:`2021`,technique:`Escultura monumental en concreto y metal, pintada con murales; un puño que sostiene la palabra “Resiste”`,image:{src:`/images/artworks/cap-03-obra.webp`,alt:`Escultura de un puño que sostiene la palabra “Resiste”, cubierta de murales de colores; alrededor, personas reunidas.`,caption:`El monumento en marzo de 2024.`,credit:`Alexa Rochi / Presidencia de Colombia · Dominio público`},commentary:`Lo levantaron en pocas semanas, con donaciones y trabajo voluntario, quienes ocupaban el antiguo Puerto Rellena, rebautizado Puerto Resistencia. No lo encargó ninguna institución. En el brazo están pintados rostros de jóvenes muertos durante las protestas. La obra reúne los temas del capítulo: la precariedad que sacó a la gente a la calle, el duelo y la decisión de una comunidad de contar su propia historia sin esperar al Estado. Sigue siendo discutida, y por eso mismo sirve: para unos es memoria, para otros recuerda los bloqueos.`},references:[{id:`ref-01`,citation:`Bancolombia. (2026). Evolución del modelo educativo superior híbrido.`,url:`https://www.bancolombia.com/empresas/capital-inteligente/actualidad-economica-sectorial/evolucion-modelo-educativo-superior-hibrido`},{id:`ref-02`,citation:`Departamento Administrativo Nacional de Estadística. (2021, 29 de abril). Pobreza monetaria, año 2020 [Comunicado de prensa].`,url:`https://www.dane.gov.co/files/investigaciones/condiciones_vida/pobreza/2020/Comunicado-pobreza-monetaria_2020.pdf`},{id:`ref-03`,citation:`Departamento Nacional de Planeación. (2021). Mercado laboral en la crisis del COVID-19.`,url:`https://colaboracion.dnp.gov.co/CDT/Sinergia/Documentos/Notas_politica_publica_EMPLEO_09_04_21_v4.pdf`},{id:`ref-04`,citation:`El Espectador. (2021, 13 de diciembre). Así está la salud mental de los colombianos.`,url:`https://www.elespectador.com/salud/asi-esta-la-salud-mental-de-los-colombianos/`},{id:`ref-05`,citation:`El Tiempo. (2020). Encuesta del DANE revela afectaciones de la pandemia en la salud mental de los colombianos.`,url:`https://www.eltiempo.com/salud/encuesta-del-dane-revela-afectaciones-de-la-pandemia-en-la-salud-mental-de-los-colombianos-544811`},{id:`ref-06`,citation:`Forbes Colombia. (2021, 30 de abril). Ayudas del Gobierno evitaron 1,7 millones de nuevos pobres en el país.`,url:`https://forbes.co/2021/04/30/economia-y-finanzas/ayudas-del-gobierno-evitaron-17-millones-de-nuevos-pobres-en-el-pais/`},{id:`ref-07`,citation:`La Estrella de Panamá. (2021). La CIDH concluye que la respuesta del gobierno a las protestas se basó en “uso desproporcionado de la fuerza”.`,url:`https://www.laestrella.com.pa/mundo/america/cidh-concluye-respuesta-gobierno-protestas-BILE451356`},{id:`ref-08`,citation:`La República. (2021, 29 de abril). Cifras del DANE sobre la pobreza monetaria en 2020.`,url:`https://www.larepublica.co/economia/siga-aqui-la-publicacion-de-las-cifras-del-dane-sobre-la-pobreza-monetaria-en-2020-3161669`},{id:`ref-09`,citation:`La Silla Vacía. (2021). La pandemia y la inasistencia escolar.`,url:`https://www.lasillavacia.com/?p=119778`},{id:`ref-10`,citation:`NTN24. (2021). CIDH presentó informe tras visita a Colombia durante el paro nacional.`,url:`https://www.ntn24.com/noticias-actualidad/cidh-presento-informe-tras-visita-a-colombia-durante-el-paro-nacional-136611`},{id:`ref-11`,citation:`Portafolio. (2021). Por pandemia, la pobreza monetaria en Colombia subió a 42,5 % en 2020.`,url:`https://www.portafolio.co/economia/dane-revela-impacto-de-la-pandemia-en-la-pobreza-del-pais-551470`},{id:`ref-12`,citation:`Universidad del Rosario. (s. f.). Trabajo informal y pandemia: de mal a peor. Revista de Divulgación Científica.`,url:`https://urosario.edu.co/revista-divulgacion-cientifica/economia-y-politica/trabajo-informal-y-pandemia-de-mal-a-peor`},{id:`ref-13`,citation:`Universidad EAFIT. (s. f.). Acceso a internet y deserción estudiantil en pandemia [Trabajo de grado].`,url:`https://repository.eafit.edu.co/bitstreams/3fc176c2-c35f-4449-a593-90e9cc4b5957/download`}]},{id:`capitulo-4`,number:4,slug:`nuevas-ciudadanias-y-giro-a-la-izquierda`,title:`Nuevas ciudadanías y giro a la izquierda`,period:`2021 – 2026`,summary:`Jóvenes, mujeres, ambientalistas y pueblos étnicos pasaron de la calle a las urnas y llevaron por primera vez a la izquierda a la presidencia. Gobernar resultó más difícil que ganar.`,cover:{src:`/images/historical/cap-04-portada.webp`,alt:`Gustavo Petro abraza a Francia Márquez en la tarima de la posesión presidencial.`,caption:`Plaza de Bolívar, 7 de agosto de 2022: Gustavo Petro felicita a la vicepresidenta Francia Márquez tras su juramento.`,credit:`César Carrión / Presidencia · CC BY 2.0`},introduction:`El 19 de junio de 2022 Gustavo Petro ganó la presidencia con cerca de 11,3 millones de votos, y Francia Márquez, lideresa ambiental afrocolombiana del Cauca, se convirtió en vicepresidenta. Colombia nunca había elegido un gobierno de izquierda.

Ese resultado no salió solo de los partidos. Lo empujaron las agendas que habían llenado las calles en 2019 y 2021: el ambientalismo, el feminismo, los derechos étnicos, los jóvenes sin oportunidades. Este capítulo mira cómo esas ciudadanías llegaron al poder, qué herramientas usaron y con qué límites se encontraron al gobernar.`,content:[{type:`heading`,text:`1. Capitales y periferias: un mapa político que se movió`},{type:`paragraph`,text:`**La periferia eligió.** En 2022 el voto por Petro se concentró en el Pacífico, el Caribe, el suroccidente y Bogotá, mientras Antioquia, los Santanderes y el eje cafetero votaron mayoritariamente por su rival. Regiones que durante décadas fueron escenario de la guerra, pero no de las decisiones, se sintieron por primera vez en el centro. El gobierno lo reforzó con símbolos y hechos: una vicepresidenta del Cauca, diálogos regionales para el plan de desarrollo y el traslado temporal del gabinete a La Guajira.`},{type:`paragraph`,text:`**Las tensiones.** Aparecieron pronto y en dos direcciones.`},{type:`list`,items:[`**Con alcaldes y gobernadores.** En las elecciones regionales de octubre de 2023, Bogotá, Medellín, Cali y Barranquilla quedaron en manos de opositores o de candidatos desligados del gobierno, según el análisis de BBC Mundo. Desde entonces hubo choques por el metro de Bogotá, las vías de Antioquia, la seguridad y el giro de recursos. Analistas advirtieron de una desconexión entre el gobierno central y las regiones.`,`**Con las propias bases.** Comunidades que esperaban cambios rápidos se encontraron con presupuestos limitados, proyectos mineros y petroleros en disputa, y grupos armados que siguieron mandando en sus territorios.`]},{type:`paragraph`,text:`**Lo que quedó claro.** Los partidos tradicionales conservaron su fuerza local. Un estudio de Diálogo Político muestra que siguieron ganando la mayoría de alcaldías y gobernaciones mediante coaliciones. En 2026 la geografía se repitió con otro desenlace: la izquierda volvió a ganar Bogotá, Chocó y La Guajira, pero perdió el país por los departamentos intermedios, como muestra el mapa electoral de El Espectador.`},{type:`heading`,text:`2. Redes sociales contra maquinarias`},{type:`table`,table:{headers:[``,`Nuevas ciudadanías`,`Partidos tradicionales`],rows:[[`Canal principal`,`TikTok, Instagram, X, WhatsApp, transmisiones en vivo`,`Estructuras regionales, líderes barriales, radio y televisión`],[`Recurso`,`Relatos personales, humor, música, consignas (“vivir sabroso”, “los nadies”)`,`Avales, alianzas entre partidos, capacidad de mover votantes el día de la elección`],[`Fortaleza`,`Llegan a jóvenes y a quienes no ven noticieros; cuestan poco`,`Ganan Congreso, alcaldías y gobernaciones`],[`Debilidad`,`Movilizan mucho y organizan poco; favorecen la desinformación y la polarización`,`Pierden credibilidad entre los jóvenes`]]}},{type:`paragraph`,text:`Las redes ya habían sido decisivas en el paro de 2021, cuando los manifestantes transmitieron en directo lo que ocurría en las calles. En la campaña de 2022, TikTok permitió a los candidatos presentarse de forma cercana e innovadora, concluye un estudio de la Revista Latina de Comunicación Social.`},{type:`paragraph`,text:`Pero las redes no son de un solo bando. Quien mejor las usó en 2022 fue Rodolfo Hernández, un empresario de 77 años que llegó a segunda vuelta casi sin mitines, según Bloomberg. El mismo reporte señala que, aun así, Petro tenía mucho más apoyo entre los votantes de 18 a 40 años. La lección es que las redes abren la puerta a nuevas voces, y también a cualquier candidato que sepa hablar su lenguaje.`},{type:`heading`,text:`3. De la consigna a la ley: los límites de gobernar`},{type:`paragraph`,text:`**El Congreso.** El gobierno nunca tuvo mayoría propia. Empezó con una coalición amplia que aprobó una reforma tributaria en 2022 y se rompió en 2023. Después, cada reforma fue una batalla:`},{type:`table`,table:{headers:[`Reforma`,`Qué pasó`],rows:[[`Laboral`,`Se hundió en marzo de 2025, revivió tras la amenaza de una consulta popular y fue sancionada el 25 de junio de 2025.`],[`Pensional`,`Aprobada como Ley 2381 de 2024; la Corte Constitucional la frenó por vicios de trámite y en 2026 avaló la mayor parte, devolviendo nueve artículos al Congreso.`],[`Salud`,`Archivada en 2024 y de nuevo a finales de 2025.`],[`Tributaria de 2025`,`Hundida al cierre de la legislatura.`]],note:`Fuentes: Infobae, Semana, La Silla Vacía y Cambio.`}},{type:`quote`,text:`“Un nuevo triunfo del gobierno del cambio y del pueblo trabajador”.`,attribution:`Gustavo Petro, sobre el fallo de la reforma pensional, citado por Semana`},{type:`paragraph`,text:`**Las cortes y los órganos de control.** La Corte Constitucional y el Consejo de Estado tumbaron o suspendieron decretos y leyes, entre ellas la que creó el Ministerio de la Igualdad. Para el gobierno fue un bloqueo; para sus críticos, la prueba de que los contrapesos funcionan.`},{type:`paragraph`,text:`**La plata.** Con déficit fiscal alto y deuda creciente, no había recursos para todo lo prometido. La reforma agraria avanzó más rápido que antes, pero a casi diez años del Acuerdo solo se ha entregado cerca del 11 % de la meta de tierras, según CIDOB.`},{type:`paragraph`,text:`**La ejecución.** Muchos líderes sociales llegaron a cargos públicos sin experiencia administrativa, y hubo escándalos de corrupción. La Contraloría calculó que el plan de desarrollo cumplió el 72,5 % de sus metas al 7 de agosto de 2026.`},{type:`quote`,text:`“…siendo el menor resultado de los últimos tres gobiernos”.`,attribution:`Contraloría General de la República, octubre de 2026, citada por Cambio`},{type:`paragraph`,text:`El balance está en disputa. Quienes defienden al gobierno destacan la reforma laboral, la pensional, la entrega de tierras y que sectores antes excluidos ocuparon el Estado. Sus críticos señalan la crisis del sistema de salud, el deterioro de la seguridad y el desorden fiscal. Las dos lecturas explican por qué en 2026 el país votó partido casi por la mitad.`}],gallery:[{src:`/images/historical/cap-04-galeria-01.webp`,alt:`Simpatizantes con banderas y una pancarta del Pacto Histórico posan alrededor de un monumento.`,caption:`Francia Márquez con simpatizantes durante la campaña presidencial de 2022.`,credit:`Wayka · CC BY 3.0`},{src:`/images/historical/cap-04-galeria-02.webp`,alt:`Un hombre de traje ajusta la banda presidencial a Gustavo Petro; a los lados, un edecán militar y una mujer emocionada.`,caption:`El presidente del Congreso, Roy Barreras, impone la banda presidencial a Gustavo Petro, 7 de agosto de 2022.`,credit:`Nelson Cárdenas / Presidencia · CC BY 2.0`},{src:`/images/historical/cap-04-galeria-03.webp`,alt:`Dos mujeres con chalecos y bastones de mando posan frente a una casa de techo de paja.`,caption:`Mujeres de la Guardia Indígena, 2022.`,credit:`Intimankiller · CC BY 4.0`},{src:`/images/historical/cap-04-galeria-04.webp`,alt:`Manifestantes con pañuelos morados y verdes llenan una avenida; en primer plano, un cartel triangular que dice “¡Alto!”.`,caption:`Bogotá, 8 de marzo de 2024: marcha del Día Internacional de la Mujer.`,credit:`Juan Vargas (WMCO) · CC BY-SA 4.0`},{src:`/images/historical/cap-04-galeria-05.webp`,alt:`Vista desde lo alto del recinto del Congreso con las curules ocupadas.`,caption:`Instalación de las sesiones del Congreso, 20 de julio de 2023.`,credit:`Juan Cano / Presidencia de Colombia · Dominio público`},{src:`/images/historical/cap-04-galeria-06.webp`,alt:`Manos que reparten pañuelos morados entre manifestantes.`,caption:`Pañuelos morados en la marcha del 8 de marzo de 2024 en Bogotá.`,credit:`Juan Vargas (WMCO) · CC BY-SA 4.0`}],artwork:{title:`Igualada`,artist:`Juan Mejía Botero (director)`,year:`2024`,technique:`Largometraje documental`,image:{src:`/images/artworks/igualada.jpg`,alt:`Afiche del documental Igualada, con un retrato de Francia Márquez y el título en letras amarillas.`,caption:`Afiche de "Igualada" (2024), dir. Juan Mejía Botero. Producción: Human Pictures, en coproducción con No Ficción. Fuente: Proimágenes Colombia.`},commentary:`El documental acompaña a Francia Márquez desde su lucha contra la minería ilegal en La Toma, Cauca, hasta la campaña de 2022. El título recoge un insulto clásico contra quien “no conoce su lugar” y lo convierte en bandera. Muestra exactamente lo que estudia el capítulo: cómo una agenda ambiental, feminista y étnica nacida en la periferia se vuelve fuerza electoral con ayuda de las redes. También deja ver, sin proponerlo, la distancia entre conquistar un cargo y transformar un Estado.`},references:[{id:`ref-01`,citation:`BBC Mundo. (2023, 30 de octubre). ¿Cómo queda Petro?: las 4 claves para entender los resultados de las elecciones regionales en Colombia.`,url:`https://www.24horas.cl/internacional/noticias-bbc/como-queda-petro-las-4-claves-para-entender-los-resultados-de-las`},{id:`ref-02`,citation:`Bloomberg. (2022, 3 de junio). La red TikTok ayudó a remodelar la carrera presidencial de Colombia, dice estratega. Asuntos Legales.`,url:`https://www.asuntoslegales.com.co/actualidad/la-red-tiktok-ayudo-a-remodelar-la-carrera-presidencial-de-colombia-dice-estratega-3376787`},{id:`ref-03`,citation:`Cambio. (2026, 23 de octubre). ¿Cumplió el Gobierno Petro? La Contraloría dice que su plan de desarrollo llegó al 72,5 %.`,url:`https://cambiocolombia.com/poder/articulo/2026/10/cumplio-el-gobierno-petro-la-contraloria-dice-que-su-plan-de-desarrollo-llego-al-725`},{id:`ref-04`,citation:`CIDOB. (s. f.). Implementación del Acuerdo Final de Paz.`,url:`https://www.cidob.org/ca/publicacions/implementacion-del-acuerdo-final-paz`},{id:`ref-05`,citation:`El Espectador. (2026). Mapa electoral segunda vuelta 2026: votos por departamento.`,url:`https://www.elespectador.com/politica/mapa-electoral-segunda-vuelta-2026-votos-por-departamento-quien-gano-en-cada-region/`},{id:`ref-06`,citation:`Infobae. (2026, 5 de julio). Solo una de las cinco reformas sociales de Gustavo Petro avanza a semanas del fin de su mandato.`,url:`https://www.infobae.com/colombia/2026/07/05/solo-una-de-las-cinco-reformas-sociales-de-gustavo-petro-avanza-a-semanas-del-fin-de-su-mandato/`},{id:`ref-07`,citation:`La Silla Vacía. (2025, diciembre). Ni salud ni plata: el Congreso le cobra a Petro su ruptura antes de elecciones.`,url:`https://www.lasillavacia.com/silla-nacional/el-congreso-le-cobra-a-petro-su-ruptura-antes-de-elecciones/`},{id:`ref-08`,citation:`Portafolio. (2023). Nuevos alcaldes y gobernadores tienen grandes desafíos.`,url:`https://www.portafolio.co/economia/finanzas/nuevos-alcaldes-y-gobernadores-tienen-grandes-desafios-591472`},{id:`ref-09`,citation:`Revista Latina de Comunicación Social. (2024). Emociones políticas y narrativas prototípicas: TikTok en las campañas presidenciales de Colombia 2022.`,url:`https://nuevaepoca.revistalatinacs.org/index.php/revista/article/view/2234`},{id:`ref-10`,citation:`Saavedra, A. M. (2023, 15 de noviembre). De la multiplicación de partidos a las nuevas coaliciones en Colombia. Diálogo Político.`,url:`https://dialogopolitico.org/agenda/colombia-nuevas-coaliciones/`},{id:`ref-11`,citation:`Semana. (2026). Corte Constitucional aprobó la esencia de la reforma pensional de Petro, pero hay más demandas que podrían tumbarla.`,url:`https://www.semana.com/nacion/articulo/corte-constitucional-aprobo-la-esencia-de-la-reforma-pensional-de-petro-pero-hay-mas-demandas-que-podrian-tumbarla/202610/`}]},{id:`capitulo-5`,number:5,slug:`vuelta-en-u-auge-de-la-derecha`,title:`Vuelta en U: auge de la derecha`,period:`2023 – 2026`,summary:`Cuatro años después del giro a la izquierda, el péndulo volvió: Abelardo de la Espriella ganó la presidencia en 2026 por menos de un punto, con un discurso de autoridad, mercado y valores conservadores.`,cover:{src:`/images/historical/cap-05-portada.webp`,alt:`Abelardo de la Espriella y Marco Rubio se dan la mano entre las banderas de Colombia y Estados Unidos.`,caption:`8 de septiembre de 2026: el presidente Abelardo de la Espriella con el secretario de Estado de EE. UU., Marco Rubio.`,credit:`Freddie Everett / U.S. Department of State · Dominio público`},introduction:`La política colombiana de este siglo se ha movido como un péndulo: de la mano firme a la negociación, de la derecha a la izquierda. En 2026 volvió a oscilar. Abelardo de la Espriella, abogado penalista sin carrera política previa, derrotó a Iván Cepeda en la segunda vuelta más reñida desde que existe ese sistema.

Este capítulo es historia en curso: el nuevo gobierno apenas cumple cien días. Por eso distingue entre lo que ya ocurrió (los resultados, las primeras decisiones) y lo que sigue en debate. Los medios lo describen de formas distintas, como derecha, derecha radical o ultraderecha; aquí se usa “derecha” y se explica qué propone.`,content:[{type:`heading`,text:`1. Los hechos: una victoria estrecha`},{type:`table`,table:{headers:[`Elección de 2026`,`De la Espriella`,`Cepeda`],rows:[[`Primera vuelta (31 de mayo)`,`43,7 %`,`40,9 %`],[`Segunda vuelta (21 de junio)`,`49,66 % (12,96 millones)`,`48,70 % (12,71 millones)`]]}},{type:`paragraph`,text:`La diferencia fue de unos 251.000 votos y la participación llegó al 63,6 %. De la Espriella se convirtió en el candidato más votado de la historia del país y asumió el 7 de agosto. Fuentes: El Espectador y Wikipedia, con datos de la Registraduría.`},{type:`paragraph`,text:`El dato importa para el análisis: el país giró, pero casi la mitad votó en sentido contrario.`},{type:`heading`,text:`2. Por qué giró la opinión pública`},{type:`paragraph`,text:`**Factores internos**`},{type:`list`,items:[`**Seguridad.** La “paz total”, que abrió varias mesas de diálogo a la vez, no redujo la violencia como se esperaba. Los grupos armados crecieron, y la extorsión y las crisis humanitarias, como la del Catatumbo en 2025, alimentaron la sensación de que el Estado había perdido el control.`,`**Economía y finanzas públicas.** Déficit alto, reformas tributarias hundidas e incertidumbre para la inversión.`,`**Salud.** Las tutelas para exigir atención pasaron de 81.736 en 2020 a cerca de 314.700 en 2025, según cifras de la Corte Constitucional citadas por Cambio.`,`**Desgaste del gobierno.** Reformas bloqueadas, escándalos de corrupción y un estilo de confrontación permanente. Las elecciones regionales de 2023 ya habían sido un primer aviso.`,`**Rechazo a la política tradicional.** Como en 2022, ganó terreno un candidato que se presentaba como ajeno a los partidos.`]},{type:`paragraph`,text:`**Factores externos**`},{type:`list`,items:[`**Un clima regional.** Los triunfos de Javier Milei en Argentina y la popularidad de Nayib Bukele en El Salvador ofrecieron modelos de recorte del Estado y mano dura.`,`**Estados Unidos.** La relación con Washington se deterioró durante el gobierno Petro. El secretario de Estado felicitó al ganador la misma noche de la elección, según CNN en Español.`,`**Venezuela.** El miedo a repetir la crisis del país vecino siguió pesando en el voto.`]},{type:`heading`,text:`3. Qué propone la derecha y con qué conecta`},{type:`table`,table:{headers:[`Eje`,`Propuesta`,`Expectativa o temor con el que conecta`],rows:[[`Autoridad`,`“Seguridad Democrática 2.0”: fin de los diálogos, más fuerza pública, bombardeos, megacárceles, erradicación de coca`,`Miedo a la extorsión y al crimen; nostalgia de los años de Uribe`],[`Economía`,`Menos impuestos, recorte del Estado, reactivar petróleo, gas y minería`,`Deseo de empleo e inversión; temor a la crisis fiscal`],[`Valores`,`Defensa de la familia y la religión; “batalla cultural” contra lo que llama “wokismo”`,`Rechazo de sectores conservadores a los cambios culturales rápidos`],[`Política exterior`,`Alianza estrecha con Estados Unidos`,`Temor al aislamiento y a parecerse a Venezuela`],[`Estilo`,`Líder fuerte, lenguaje directo, redes sociales`,`Cansancio con los políticos de siempre`]],note:`Fuentes: La Opinión, El Tiempo y Corporación Viva la Ciudadanía.`}},{type:`quote`,text:`“Cero negociación con criminales”.`,attribution:`Programa de gobierno de Abelardo de la Espriella, citado por RCN Radio`},{type:`paragraph`,text:`El mismo discurso despierta temores en la otra mitad del país: que se repitan abusos como los falsos positivos, que se pierdan derechos reconocidos a mujeres, personas LGBTIQ+ y pueblos étnicos, y que se abandone el Acuerdo de Paz.`},{type:`heading`,text:`4. Los debates que se abren`},{type:`paragraph`,text:`**Paz.** El gobierno cerró las mesas de la “paz total” y sacó adelante una ley de sometimiento. Dice que cumplirá el Acuerdo de 2016, pero con recortes, informa El Espectador. La discusión es si puede reducir el presupuesto de la JEP o cambiar sus reglas cuando parte del Acuerdo es un compromiso constitucional vigente.`},{type:`paragraph`,text:`**Diversidad.** En cien días hubo más de 400 recortes de personal en el Ministerio de la Igualdad y cambios en la política cultural, según el balance de El Espectador. Para el gobierno es austeridad y defensa de valores tradicionales; para organizaciones de mujeres y LGBTIQ+, un retroceso. Los derechos ya reconocidos por la Corte Constitucional no dependen del Ejecutivo, y ahí estará el pulso.`},{type:`paragraph`,text:`**Ambiente.** El nuevo gobierno quiere reactivar la exploración de petróleo y gas y ha abierto la puerta al fracking, frenado en el cuatrienio anterior. El debate enfrenta ingresos fiscales y seguridad energética contra los compromisos climáticos y la protección del agua, como resume Ambientarte Radio.`},{type:`paragraph`,text:`**Calle y contrapesos.** El gobierno enfrentó un terremoto a los tres días de posesionado y tramita un ajuste fiscal con nuevos impuestos. Sindicatos y oposición convocaron protestas para el 19 de noviembre, reporta La Jornada. Los mismos límites que frenaron a la izquierda (Congreso, cortes, presupuesto y movilización) operan ahora sobre la derecha.`},{type:`quote`,text:`Cien días son “poco para medir resultados y suficiente para ver hacia dónde va”.`,attribution:`Columna de opinión, La Silla Vacía, noviembre de 2026`}],gallery:[{src:`/images/historical/cap-05-galeria-01.webp`,alt:`Multitud reunida de noche en una calle, con banderas y una pancarta con retratos.`,caption:`Pasto, 21 de junio de 2026: simpatizantes de Iván Cepeda celebran su victoria en Nariño, pese a la derrota nacional.`,credit:`Vlahebo · CC BY-SA 4.0`},{src:`/images/historical/cap-05-galeria-02.webp`,alt:`Mapa de Colombia por municipios, coloreado según el candidato ganador en la segunda vuelta de 2026.`,caption:`Segunda vuelta de 2026: candidato más votado en cada municipio.`,credit:`MP DDT · CC BY 4.0`},{src:`/images/historical/cap-05-galeria-03.webp`,alt:`Dos hombres de traje y dos mujeres posan entre las banderas de Colombia y Ecuador.`,caption:`Cali, 7 de agosto de 2026: Abelardo de la Espriella en un encuentro con la Presidencia de Ecuador antes de su investidura.`,credit:`Isaac Castillo / Presidencia del Ecuador · Dominio público`},{src:`/images/historical/cap-05-galeria-04.webp`,alt:`Mapa de Colombia por departamentos, coloreado según el partido del gobernador elegido en 2023.`,caption:`Elecciones regionales de octubre de 2023: partido ganador de cada gobernación.`,credit:`MeinRawef · CC BY-SA 4.0`},{src:`/images/historical/cap-05-galeria-05.webp`,alt:`Soldados con casco y uniforme camuflado, formados frente a un helicóptero.`,caption:`Tolemaida, 7 de noviembre de 2026: soldados del Ejército de Colombia en el ejercicio binacional Southern Vanguard 27.`,credit:`Pfc. Isabella Youngblood / U.S. Army · Dominio público`},{src:`/images/historical/cap-05-galeria-06.webp`,alt:`Manifestantes con carteles y banderas marchan por una calle.`,caption:`Cali, 14 de octubre de 2026: manifestación contra el gobierno de Abelardo de la Espriella.`,credit:`Sahaquiel9102 · CC BY-SA 4.0`}],artwork:{title:`Duelo a garrotazos`,artist:`Francisco de Goya`,year:`1820 – 1823`,technique:`Pintura mural trasladada a lienzo (serie de las Pinturas negras). Museo Nacional del Prado, Madrid`,image:{src:`/images/artworks/cap-05-obra.webp`,alt:`Pintura de dos hombres hundidos hasta las rodillas que se golpean con garrotes en un paisaje abierto.`,caption:`Museo Nacional del Prado, Madrid.`,credit:`Dominio público`},commentary:`Dos hombres, hundidos hasta las rodillas, se golpean con garrotes. Ninguno puede huir ni ganar del todo. Goya pintó así una España dividida, y la imagen se usa desde entonces para hablar de sociedades partidas en dos bandos. Sirve para este capítulo porque el péndulo colombiano no oscila entre mayorías claras: 2016, 2022 y 2026 se decidieron por márgenes mínimos. La obra no toma partido y permite discutir en clase qué le pasa a un país cuando cada mitad gobierna contra la otra.`},references:[{id:`ref-01`,citation:`Ambientarte Radio. (2026, 8 de agosto). Abelardo de la Espriella y los retos de un gobierno que promete cambiar las reglas del juego.`,url:`https://www.ambientarteradio.com/2026/08/08/abelardo-de-la-espriella-y-los-retos-de-su-nuevo-gobierno-fracking-fumigacion-jep-impuestos-y-poder-presidencial/`},{id:`ref-02`,citation:`Cambio. (2026, 23 de octubre). ¿Cumplió el Gobierno Petro? La Contraloría dice que su plan de desarrollo llegó al 72,5 %.`,url:`https://cambiocolombia.com/poder/articulo/2026/10/cumplio-el-gobierno-petro-la-contraloria-dice-que-su-plan-de-desarrollo-llego-al-725`},{id:`ref-03`,citation:`CNN en Español. (2026, 21 de junio). Resultado de la segunda vuelta en Colombia: De la Espriella gana las elecciones, según el preconteo.`,url:`https://cnnespanol.cnn.com/2026/06/21/colombia/live-news/segunda-vuelta-elecciones-presidenciales-resultado-cepeda-espriella-orix`},{id:`ref-04`,citation:`Corporación Viva la Ciudadanía. (2026). Abelardo de la Espriella: de la campaña al poder. Revista Sur.`,url:`https://www.sur.org.co/abelardo-de-la-espriella-de-la-campana-al-poder-la-continuidad-de-un-proyecto-de-derecha-radical-y-los-desafios-de-su-gobierno/`},{id:`ref-05`,citation:`El Espectador. (2026). Mapa electoral segunda vuelta 2026: votos por departamento.`,url:`https://www.elespectador.com/politica/mapa-electoral-segunda-vuelta-2026-votos-por-departamento-quien-gano-en-cada-region/`},{id:`ref-06`,citation:`El Espectador. (2026, 14 de noviembre). De la Espriella y sus primeros 100 días: ¿qué ha pasado con los derechos de mujeres y LGBT?`,url:`https://www.elespectador.com/genero-y-diversidad/las-igualadas/de-la-espriella-y-sus-primeros-100-dias-que-ha-pasado-con-los-derechos-de-mujeres-y-lgbt/`},{id:`ref-07`,citation:`El Espectador. (2026, 14 de noviembre). La paz y De la Espriella: la política de mano dura y no negociación que instauró en 100 días.`,url:`https://www.elespectador.com/politica/la-paz-y-de-la-espriella-la-politica-de-mano-dura-y-no-negociacion-que-instauro-en-100-dias/`},{id:`ref-08`,citation:`El Tiempo. (2026). Las 5 apuestas del gobierno de Abelardo de la Espriella en materia de seguridad y defensa.`,url:`https://www.eltiempo.com/amp/justicia/conflicto-y-narcotrafico/las-5-apuestas-del-gobierno-de-abelardo-de-la-espriella-en-materia-de-seguridad-y-defensa-3570688`},{id:`ref-09`,citation:`Gómez, J. (2026, 14 de noviembre). Entre protestas, De la Espriella cumple 100 días como presidente de Colombia. La Jornada.`,url:`https://www.jornada.com.mx/2026/11/14/mundo/018n1mun?partner=rss`},{id:`ref-10`,citation:`La Opinión. (2026). Seguridad, austeridad y reducción del Estado: las apuestas del gobierno de Abelardo de la Espriella.`,url:`https://laopinion.co/elecciones-2026/seguridad-austeridad-y-reduccion-del-estado-las-apuestas-del-gobierno-de-abelardo`},{id:`ref-11`,citation:`La Silla Vacía. (2026, noviembre). Van 100, faltan 1.361 [Opinión].`,url:`https://www.lasillavacia.com/opinion/van-100-faltan-1-361/`},{id:`ref-12`,citation:`RCN Radio. (2026). ¿Qué propone el presidente Abelardo de la Espriella en materia de seguridad para su gobierno 2026–2030?`,url:`https://newsroom.rcnradio.com/colombia/cual-es-la-propuesta-de-seguridad-de-abelardo-de-la-espriella-para-su-presidencia-2026-2030`},{id:`ref-13`,citation:`Wikipedia. (2026). 2026 Colombian presidential election.`,url:`https://en.wikipedia.org/wiki/2026_Colombian_presidential_election`}]}];function Rr(e){let t=e.introduction!==null,n=e.content.length>0;return t&&n?`ready`:t||n?`draft`:`pending`}function zr(e){return Lr.find(t=>t.slug===e)}function Br(e){let t=Lr.findIndex(t=>t.slug===e);return{previous:t>0?Lr[t-1]:void 0,next:t>=0&&t<Lr.length-1?Lr[t+1]:void 0}}var Vr={video:{title:`Entrevista`,url:null,poster:null,duration:null,description:`Una conversación semiestructurada que explora la experiencia del regreso a la presencialidad, las clases virtuales y el contexto del estallido social.`},interviewee:{name:`Marly Viviana Tafur`,role:`Docente-investigadora, Unidad de Proyectos Especiales, Universidad de Ibagué`,description:`Profesional en Ciencias Sociales y magíster en Territorio, Conflicto y Cultura. Cuenta con diez años de experiencia en el ámbito social, educativo y de investigación-acción con comunidades. Desde hace siete años es docente-investigadora de la Unidad de Proyectos Especiales de la Universidad de Ibagué, donde trabaja en el diseño de ambientes de aprendizaje, la co-creación con comunidades y la apropiación social del conocimiento.`,photo:{src:`/images/people/marly-viviana-tafur.jpg`,alt:`Retrato de Marly Viviana Tafur`}},context:[{label:`Fecha`,value:`9 de noviembre de 2026`},{label:`Lugar`,value:`Universidad de Ibagué`},{label:`Modalidad`,value:`Semiestructurada`},{label:`Entrevista realizada por`,value:`Juliana Torres y equipo`}],transcript:[]},Hr={video:{title:`Video reflexivo`,url:null,poster:null,duration:null,description:null},details:[{label:`Realización`,value:null},{label:`Fecha`,value:null},{label:`Formato`,value:null}],notes:null},Ur={info:[{label:`Asignatura`,value:M.course},{label:`Universidad`,value:M.university},{label:`Docente`,value:`Sandra Gutiérrez Abella`},{label:`Descripción de la docente`,value:`Antropóloga. Mg. Educación. Profesora TC, Facultad de Humanidades, Artes y Ciencias Sociales`},{label:`Periodo académico`,value:`2026-B`},{label:`Grupo`,value:`02`}],members:[{id:`juliana-torres`,name:`Juliana Torres`,role:null,photo:{src:`/images/people/juliana-torres.jpg`,alt:`Retrato de Juliana Torres`}},{id:`santiago-leiva`,name:`Santiago Leiva`,role:null,photo:{src:`/images/people/santiago-leiva.jpg`,alt:`Retrato de Santiago Leiva`}},{id:`wilson-cespedes`,name:`Wilson Céspedes`,role:null,photo:{src:`/images/people/wilson-cespedes.jpg`,alt:`Retrato de Wilson Céspedes`}}]};function N(...e){return e.filter(Boolean).join(` `)}var Wr={fill:`none`,stroke:`currentColor`,strokeLinecap:`round`,strokeLinejoin:`round`,vectorEffect:`non-scaling-stroke`};function Gr({variant:e,className:t}){return e===`underline`?(0,j.jsx)(`span`,{"aria-hidden":!0,className:N(`pointer-events-none absolute inset-x-0 -bottom-2 h-3 text-red`,t),children:(0,j.jsxs)(`svg`,{viewBox:`0 0 300 20`,preserveAspectRatio:`none`,className:`rough size-full overflow-visible`,children:[(0,j.jsx)(`path`,{d:`M3 8 C 60 3, 150 13, 297 5`,strokeWidth:`3.5`,...Wr}),(0,j.jsx)(`path`,{d:`M14 15 C 90 10, 200 18, 272 11`,strokeWidth:`2`,...Wr})]})}):e===`circle`?(0,j.jsx)(`span`,{"aria-hidden":!0,className:N(`pointer-events-none absolute -inset-x-3 -inset-y-2 text-red`,t),children:(0,j.jsx)(`svg`,{viewBox:`0 0 300 100`,preserveAspectRatio:`none`,className:`rough size-full overflow-visible`,children:(0,j.jsx)(`path`,{d:`M22 56 C 14 22, 108 5, 190 8 C 264 11, 297 34, 287 60 C 276 88, 182 97, 102 92 C 42 88, 6 76, 13 48 C 20 22, 92 9, 160 8`,strokeWidth:`2.5`,...Wr})})}):e===`crown`?(0,j.jsxs)(`svg`,{"aria-hidden":!0,viewBox:`0 0 64 48`,className:N(`rough pointer-events-none absolute overflow-visible text-red`,t),children:[(0,j.jsx)(`path`,{d:`M6 42 L10 10 L22 28 L32 4 L42 28 L54 10 L58 42 Z`,strokeWidth:`3`,...Wr}),(0,j.jsx)(`path`,{d:`M9 36 L55 35`,strokeWidth:`2`,...Wr})]}):(0,j.jsxs)(`svg`,{"aria-hidden":!0,viewBox:`0 0 48 40`,className:N(`rough pointer-events-none absolute overflow-visible text-red`,t),children:[(0,j.jsx)(`path`,{d:`M6 34 L14 8`,strokeWidth:`3.5`,...Wr}),(0,j.jsx)(`path`,{d:`M21 36 L27 10`,strokeWidth:`3.5`,...Wr}),(0,j.jsx)(`path`,{d:`M36 33 L40 12`,strokeWidth:`3.5`,...Wr})]})}function Kr({children:e,as:t=`div`,className:n}){return(0,j.jsx)(t,{className:N(`container-site`,n),children:e})}function qr({name:e,className:t}){return(0,j.jsxs)(`span`,{className:N(`flex min-w-0 items-center gap